<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>netcoreapp3.1</TargetFramework>
    <PackageId>gitRelease</PackageId>
    <ToolCommandName>gitRelease</ToolCommandName>
    <PackAsTool>true</PackAsTool>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <Owners>CraftingIT</Owners>
    <PackageProjectUrl>https://hub.docker.com/r/craftingit/gitrelease</PackageProjectUrl>
    <Title>gitRelease</Title>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.Invariant" Value="true" />
    <None Include="LICENSE" Pack="true" Visible="false" PackagePath=""/>
    <Compile Remove="deps\**" />
    <Compile Remove="Gitea.API\**" />
    <EmbeddedResource Remove="deps\**" />
    <EmbeddedResource Remove="Gitea.API\**" />
    <None Remove="deps\**" />
    <None Remove="Gitea.API\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Octokit" Version="0.43.0" />
    <PackageReference Include="CommandLineParser" Version="2.7.82" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="CommandLineParser.2.6.0\.signature.p7s" />
    <None Remove="CommandLineParser.2.6.0\README.md" />
    <None Remove="CommandLineParser.2.6.0\lib\netstandard2.0\CommandLine.xml" />
    <None Remove="CommandLineParser.2.6.0\lib\netstandard2.0\CommandLine.dll" />
    <None Remove="CommandLineParser.2.6.0\lib\net45\CommandLine.xml" />
    <None Remove="CommandLineParser.2.6.0\lib\net45\CommandLine.dll" />
    <None Remove="CommandLineParser.2.6.0\lib\net40\CommandLine.xml" />
    <None Remove="CommandLineParser.2.6.0\lib\net40\CommandLine.dll" />
    <None Remove="CommandLineParser.2.6.0\CommandLineParser.2.6.0.nupkg" />
    <None Remove="CommandLineParser.2.6.0\lib\net461\CommandLine.xml" />
    <None Remove="CommandLineParser.2.6.0\lib\net461\CommandLine.dll" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="Gitea.API\Gitea.API.csproj" />
  </ItemGroup>
</Project>
